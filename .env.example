# ── App ────────────────────────────────────────────────────────────────────
DATABASE_URL="file:./prisma/prod.db"
NEXTAUTH_SECRET="replace-with-a-random-64-char-string"
NEXTAUTH_URL="http://YOUR_EC2_PUBLIC_IP:3000"

# ── AWS ────────────────────────────────────────────────────────────────────
# If you attach an IAM role to the EC2 instance these can be left blank.
# If not, paste your access keys here.
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# ── S3 ─────────────────────────────────────────────────────────────────────
S3_BUCKET_NAME="dim-wiz-uploads"
